{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-2",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Workflow",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)"
    ],
    "deny": [
      "Bash(git config *)",
      "Bash(brew install *)",
      "Bash(chmod 777 *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(gh repo delete:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5-2[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/session-start.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/agent-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__linear-mcp__.*|mcp__plane-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/tracker-lock.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/guard.py"
          },
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/commit-gate.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/input-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/deny-check.sh"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/relay-check.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|SendMessage|Agent|Workflow|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/hold-gate.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/restate-gate.py"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow|SendMessage|mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/brief-check.py"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/route-check.py"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/knowledge-check.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/md-check.py"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow|Bash|PowerShell|Edit|Write|MultiEdit|mcp__linear-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/skill-push.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/cost-meter.py"
          },
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/misread-check.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/output-check.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/agent-cap.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" ~/.claude/hooks/agent-contract.py"
          }
        ]
      }
    ]
  },
  "workflowSizeGuideline": "medium",
  "enabledPlugins": {
    "typesafe@typesafe-ai": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": false,
    "jev-band@hexis-mods": true
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "hexis-mods": {
      "source": {
        "source": "directory",
        "path": "~/.claude/mods"
      }
    }
  },
  "language": "Japanese",
  "feedbackDrafts": "notify",
  "ultracode": true,
  "advisorModel": "fable",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
